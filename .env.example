# Emporia Vue Account Credentials
EMPORIA_USERNAME=you@email.com
EMPORIA_PASSWORD=your-password

# Grafana Cloud Configuration
# Find these in Grafana Cloud -> Connections -> Add new connection -> Hosted Prometheus metrics
GRAFANA_REMOTE_WRITE_URL=https://prometheus-prod-XX-prod-us-east-0.grafana.net/api/prom/push
GRAFANA_USERNAME=123456
GRAFANA_API_KEY=glc_xxxxxxxxxxxxxxxx

# Optional Settings
SCRAPE_INTERVAL=60
LOG_LEVEL=INFO
